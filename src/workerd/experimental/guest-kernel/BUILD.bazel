load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_library")

# gk: run a process inside a KVM guest as guest ring 0 (see README.md). The
# library is Linux only, on x86-64 and arm64 (it needs /dev/kvm and
# hand-written guest entry code for each), so it is gated with
# target_compatible_with. Embedders add it to their deps through the
# :is_supported select below, which drops it (and the WORKERD_HAS_GUEST_KERNEL
# define) on every other platform.
#
# The standalone Makefile still builds gk + gk_test directly (see README.md);
# this cc_library is for linking gk into the workerd binary.

# The handler allocation guard (see GK_GUARD_HANDLER_ALLOC in gk.c): off by
# default, and never in a shipping build. On, gk aborts on any allocation made
# inside a fault, a signal-time field write or a registered hostcall handler,
# which needs both the define and --wrap on the link of whatever binary links
# gk -- hence a flag here rather than a command line, so the wrap reaches that
# binary and no other (a host tool that does not link gk would have no
# __wrap_malloc to resolve). Pair it with --//src/workerd/server:use_tcmalloc=False;
# gk.c says why.
bool_flag(
    name = "handler_alloc_guard",
    build_setting_default = False,
)

config_setting(
    name = "guard_handler_alloc",
    flag_values = {"handler_alloc_guard": "True"},
)

# Shrinks the runtime-image table below what any real binary needs (see
# GK_NEG_IMAGE_LIMIT in gk.c), so that the overflow path runs: gk_init fails
# with a report naming the limit, and a caller that mistakes that for "this
# machine has no /dev/kvm" is caught. Off by default, and never in a shipping
# build. Left out of --platform_suffix so that flipping it rebuilds gk.c and
# relinks rather than rebuilding the tree.
bool_flag(
    name = "neg_image_limit",
    build_setting_default = False,
)

config_setting(
    name = "negative_image_limit",
    flag_values = {"neg_image_limit": "True"},
)

# True only on the platform gk supports; used by embedders to select the dep.
selects.config_setting_group(
    name = "is_linux_x86_64",
    match_all = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

selects.config_setting_group(
    name = "is_linux_aarch64",
    match_all = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

# True only on the platforms gk supports; used by embedders to select the dep.
selects.config_setting_group(
    name = "is_supported",
    match_any = [
        ":is_linux_x86_64",
        ":is_linux_aarch64",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "guest-kernel",
    srcs = [
        "gk.c",
        "gk_asm.S",
    ],
    hdrs = ["gk.h"],
    # The parts gk.c and gk_asm.S include (see gk_internal.h).
    textual_hdrs = glob(
        [
            "gk_*.c",
            "gk_*.h",
            "gk_asm_*.S",
        ],
        exclude = ["gk_test.c"],
    ),
    # The guest-entry code and anything that runs inside the guest must not carry
    # a stack canary (it reads a TLS slot the guest has not set up) or, on
    # x86-64, CET endbr markers, and must build without them for the whole
    # library since gk_run's callee runs in the guest.
    copts = ["-fno-stack-protector"] + select({
        ":is_linux_x86_64": ["-fcf-protection=none"],
        "//conditions:default": [],
    }),
    # Let a dependent gate the gk_init() call site: the define is present only
    # when this library is actually linked in (via the :is_supported select).
    defines = ["WORKERD_HAS_GUEST_KERNEL=1"] + select({
        ":guard_handler_alloc": ["GK_GUARD_HANDLER_ALLOC=1"],
        "//conditions:default": [],
    }) + select({
        ":negative_image_limit": ["GK_NEG_IMAGE_LIMIT=1"],
        "//conditions:default": [],
    }),
    # Carried to every binary that links gk, and to none that does not, which is
    # what makes __wrap_malloc resolvable exactly where it is defined.
    linkopts = select({
        ":guard_handler_alloc": ["-Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc"],
        "//conditions:default": [],
    }),
    # Expose the header as <workerd/experimental/guest-kernel/gk.h>, matching the
    # rest of the tree.
    strip_include_prefix = "/src",
    target_compatible_with = select({
        ":is_supported": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)
