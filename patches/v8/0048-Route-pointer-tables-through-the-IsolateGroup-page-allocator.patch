+  } else if (root_space->CanAllocateSubspaces()) [[likely]] {
     auto subspace = root_space->AllocateSubspace(
         VirtualAddressSpace::kNoHint, reservation_size, kAlignment,
         PagePermissions::kReadWrite, pkey);
