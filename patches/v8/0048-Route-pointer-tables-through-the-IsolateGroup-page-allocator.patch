 namespace v8::internal {
 
-void SegmentedTableBase::Initialize(size_t reservation_size,
-                                    size_t read_only_reservation_size,
-                                    bool wants_write_protection) {
+#ifdef V8_TARGET_ARCH_64_BIT
+namespace {
+
+v8::PageAllocator::Permission ToPageAllocatorPermission(
+    PagePermissions permissions) {
+  switch (permissions) {
+    case PagePermissions::kNoAccess:
+      return v8::PageAllocator::kNoAccess;
+    case PagePermissions::kRead:
+      return v8::PageAllocator::kRead;
+    case PagePermissions::kReadWrite:
+      return v8::PageAllocator::kReadWrite;
+    case PagePermissions::kReadWriteExecute:
+      return v8::PageAllocator::kReadWriteExecute;
+    case PagePermissions::kReadExecute:
+      return v8::PageAllocator::kReadExecute;
+    default:
+      // Other combinations are currently not supported.
+      UNREACHABLE();
+  }
+}
+
+// The virtual address space of a table whose backing memory the embedder
+// places (see v8::IsolateGroup::CreateParams::page_allocator). It stands in
+// for the subspace of the platform address space that backs a table
+// otherwise: the whole reservation is taken from the embedder's page
+// allocator up front, inaccessible, and the table's pages are handed out
+// from it, so all of the table lies where the embedder put it. A table's
+// read-only segments are ordinary pages of the reservation too: Initialize()
+// allocates them through AllocatePages() with the reservation base as the
+// hint, which is honored because nothing else has been handed out yet, so
+// they need no separate handling here. Only what the tables use is
+// supported: no shared pages and no subspaces. A memory protection key, if
+// given, is applied to the reservation and kept on freed pages as
+// VirtualAddressSubspace does.
+class EmbedderReservationAddressSpace final : public v8::VirtualAddressSpace {
+ public:
+  // Reserves |size| bytes aligned to |alignment| from |page_allocator|.
+  // Returns null if the reservation fails.
+  static std::unique_ptr<EmbedderReservationAddressSpace> Create(
+      v8::PageAllocator* page_allocator, size_t size, size_t alignment,
+      std::optional<MemoryProtectionKeyId> pkey) {
+    void* base = page_allocator->AllocatePages(nullptr, size, alignment,
+                                               v8::PageAllocator::kNoAccess);
+    if (!base) return nullptr;
+    return std::unique_ptr<EmbedderReservationAddressSpace>(
+        new EmbedderReservationAddressSpace(
+            page_allocator, reinterpret_cast<Address>(base), size, pkey));
+  }
+
+  ~EmbedderReservationAddressSpace() override {
+    CHECK(page_allocator_->FreePages(reinterpret_cast<void*>(base()), size()));
+  }
+
+  void SetRandomSeed(int64_t seed) override {
+    base::MutexGuard guard(&mutex_);
+    rng_.SetSeed(seed);
+  }
+
+  Address RandomPageAddress() override {
+    base::MutexGuard guard(&mutex_);
+    Address addr = base() + (static_cast<uint64_t>(rng_.NextInt64()) % size());
+    return RoundDown(addr, allocation_granularity());
+  }
+
+  Address AllocatePages(Address hint, size_t size, size_t alignment,
+                        PagePermissions permissions) override {
+    base::MutexGuard guard(&mutex_);
+    Address address = region_allocator_.AllocateRegion(hint, size, alignment);
+    if (address == base::RegionAllocator::kAllocationFailure) {
+      return kNullAddress;
+    }
+    // Reserved pages are inaccessible; changing their permissions in place
+    // keeps the protection key they carry.
+    if (!SetPagePermissions(address, size, permissions)) {
+      CHECK_EQ(size, region_allocator_.FreeRegion(address));
+      return kNullAddress;
+    }
+    return address;
+  }
+
+  void FreePages(Address address, size_t size) override {
+    base::MutexGuard guard(&mutex_);
+    CHECK_EQ(size, region_allocator_.FreeRegion(address));
+    CHECK(page_allocator_->DecommitPages(reinterpret_cast<void*>(address),
+                                         size));
+    ApplyKey(address, size);
+  }
+
+  bool SetPagePermissions(Address address, size_t size,
+                          PagePermissions permissions) override {
+    return page_allocator_->SetPermissions(
+        reinterpret_cast<void*>(address), size,
+        ToPageAllocatorPermission(permissions));
+  }
+
+  bool AllocateGuardRegion(Address address, size_t size) override {
+    base::MutexGuard guard(&mutex_);
+    // Reserved pages are inaccessible already, so only the region is marked.
+    return region_allocator_.AllocateRegionAt(address, size);
+  }
+
+  void FreeGuardRegion(Address address, size_t size) override {
+    base::MutexGuard guard(&mutex_);
+    CHECK_EQ(size, region_allocator_.FreeRegion(address));
+  }
+
+  Address AllocateSharedPages(Address hint, size_t size,
+                              PagePermissions permissions,
+                              SharedMemoryHandle handle,
+                              uint64_t offset) override {
+    // The tables never map shared memory into their reservation.
+    UNREACHABLE();
+  }
+
+  void FreeSharedPages(Address address, size_t size) override {
+    UNREACHABLE();
+  }
+
+  std::optional<MemoryProtectionKeyId> ActiveMemoryProtectionKey() override {
+    return pkey_;
+  }
+
+  bool CanAllocateSubspaces() override { return false; }
+
+  std::unique_ptr<v8::VirtualAddressSpace> AllocateSubspace(
+      Address hint, size_t size, size_t alignment,
+      PagePermissions max_page_permissions,
+      std::optional<MemoryProtectionKeyId> key,
+      std::optional<SharedMemoryHandle> handle) override {
+    UNREACHABLE();
+  }
+
+  bool RecommitPages(Address address, size_t size,
+                     PagePermissions permissions) override {
+    return page_allocator_->RecommitPages(
+        reinterpret_cast<void*>(address), size,
+        ToPageAllocatorPermission(permissions));
+  }
+
+  bool DiscardSystemPages(Address address, size_t size) override {
+    return page_allocator_->DiscardSystemPages(
+        reinterpret_cast<void*>(address), size);
+  }
+
+  bool DecommitPages(Address address, size_t size) override {
+    if (!page_allocator_->DecommitPages(reinterpret_cast<void*>(address),
+                                        size)) {
+      return false;
+    }
+    ApplyKey(address, size);
+    return true;
+  }
+
+ private:
+  EmbedderReservationAddressSpace(v8::PageAllocator* page_allocator,
+                                  Address base, size_t size,
+                                  std::optional<MemoryProtectionKeyId> pkey)
+      : VirtualAddressSpace(page_allocator->CommitPageSize(),
+                            page_allocator->AllocatePageSize(), base, size,
+                            PagePermissions::kReadWrite),
+        page_allocator_(page_allocator),
+        region_allocator_(base, size, page_allocator->AllocatePageSize()),
+        pkey_(pkey) {
+    ApplyKey(base, size);
+  }
+
+  // Tags the inaccessible pages at [address, address + size) with the
+  // protection key, if there is one. Decommitting pages replaces them with
+  // fresh ones that carry no key, so this is redone after every decommit.
+  void ApplyKey(Address address, size_t size) {
+    if (!pkey_) return;
+#if V8_HAS_PKU_SUPPORT
+    CHECK(base::MemoryProtectionKey::HasMemoryProtectionKeyAPIs());
+    CHECK(base::MemoryProtectionKey::SetPermissionsAndKey(
+        {address, size}, PagePermissions::kNoAccess, *pkey_));
+#else
+    UNREACHABLE();
+#endif  // V8_HAS_PKU_SUPPORT
+  }
+
+  v8::PageAllocator* const page_allocator_;
+  base::Mutex mutex_;
+  base::RegionAllocator region_allocator_;
+  base::RandomNumberGenerator rng_;
+  const std::optional<MemoryProtectionKeyId> pkey_;
+};
+
+}  // namespace
+#endif  // V8_TARGET_ARCH_64_BIT
