From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bert Belder <bertbelder@gmail.com>
Date: Thu, 16 Oct 2026 12:00:00 +0000
Subject: Canonicalize wasm types under an embedder shared-allocation scope

The wasm type canonicalizer is a process-wide singleton, held by the
process-wide WasmEngine, and its storage grows from whichever isolate
first needs a type that is not canonicalized yet: the zone, the
canonical supertype vector and the two recursion-group sets are all
filled from inside AddRecursiveGroup and AddRecursiveSingletonGroup.
The JS API alone grows it -- WasmJs::Install canonicalizes the
signatures of the WebAssembly builtins, on every Context::New -- so the
first isolate in the process places the containers and a later
isolate's rehash moves them again.

An embedder that gives each isolate its own allocation arena,
unaddressable from every other isolate, then finds that storage in the
arena of whichever isolate last grew it, where the next isolate's
Context::New faults reading the recursion-group sets.

Let such an embedder define a pair of weak hook functions, under which
the canonicalizer's growing entry points run, so that it can switch the
calling thread's allocation onto memory every isolate shares for the
duration. Without the hooks nothing changes. The singleton itself needs
no scope: it is constructed from V8::Initialize, before any isolate
exists.
---
diff --git a/src/wasm/canonical-types.cc b/src/wasm/canonical-types.cc
--- a/src/wasm/canonical-types.cc
+++ b/src/wasm/canonical-types.cc
@@ -17,12 +17,59 @@
 #include "src/wasm/std-object-sizes.h"
 #include "src/wasm/wasm-engine.h"
 
+// The process-wide wasm type canonicalizer and the embedder's allocator. The
+// canonicalizer's storage -- its zone, the canonical supertype vector and the
+// two recursion-group sets -- is process-wide state that grows from whichever
+// isolate first needs a type, and an embedder that gives each isolate its own
+// allocation arena, unaddressable from other isolates, needs that storage
+// placed elsewhere: it defines the two functions below (both or neither), and
+// every entry point that grows the storage then runs between an enter and the
+// matching leave, so that all of it goes where the embedder puts memory shared
+// by every isolate. The token the enter returns is handed back to the leave.
+#if defined(__GNUC__) || defined(__clang__)
+extern "C" {
+uintptr_t v8_wasm_shared_allocation_enter() __attribute__((weak));
+void v8_wasm_shared_allocation_leave(uintptr_t token) __attribute__((weak));
+}
+#define V8_HAS_WASM_SHARED_ALLOCATION_HOOKS 1
+#endif
+
 namespace v8::internal::wasm {
 
+namespace {
+// Enters the embedder's shared-allocation state for the lifetime of the scope,
+// when the embedder provides it (see the hooks above).
+class WasmSharedAllocationScope final {
+ public:
+  WasmSharedAllocationScope() {
+#ifdef V8_HAS_WASM_SHARED_ALLOCATION_HOOKS
+    if (v8_wasm_shared_allocation_enter != nullptr) {
+      token_ = v8_wasm_shared_allocation_enter();
+      active_ = true;
+    }
+#endif
+  }
+  ~WasmSharedAllocationScope() {
+#ifdef V8_HAS_WASM_SHARED_ALLOCATION_HOOKS
+    if (active_) v8_wasm_shared_allocation_leave(token_);
+#endif
+  }
+  WasmSharedAllocationScope(const WasmSharedAllocationScope&) = delete;
+  WasmSharedAllocationScope& operator=(const WasmSharedAllocationScope&) =
+      delete;
+
+ private:
+  uintptr_t token_ = 0;
+  bool active_ = false;
+};
+}  // namespace
+
 TypeCanonicalizer* GetTypeCanonicalizer() {
   return GetWasmEngine()->type_canonicalizer();
 }
 
+// Constructed from V8::Initialize, before any isolate exists and so before any
+// isolate's arena can be the calling thread's: no scope needed here.
 TypeCanonicalizer::TypeCanonicalizer() { AddPredefinedTypes(); }
 
 void TypeCanonicalizer::AddRecursiveGroup(WasmModule* module, uint32_t size) {
@@ -34,6 +81,10 @@
 
   uint32_t start_index = static_cast<uint32_t>(module->types.size() - size);
 
+  // Everything below that allocates allocates into this class's storage, which
+  // belongs to the process and not to the calling isolate. What is written
+  // into {module} goes into storage the module already has.
+  WasmSharedAllocationScope shared_allocation;
   // Multiple threads could try to register recursive groups concurrently.
   // TODO(manoskouk): Investigate if we can fine-grain the synchronization.
   base::MutexGuard mutex_guard(&mutex_);
@@ -100,6 +151,7 @@
 void TypeCanonicalizer::AddRecursiveSingletonGroup(WasmModule* module) {
   DCHECK(!module->types.empty());
   uint32_t type_index = static_cast<uint32_t>(module->types.size() - 1);
+  WasmSharedAllocationScope shared_allocation;
   base::MutexGuard guard(&mutex_);
   if (V8_UNLIKELY(canonical_supertypes_.size() == kMaxCanonicalTypes)) {
     auto oom_detail = base::FormattedString{}
@@ -158,6 +210,7 @@
   CanonicalType canonical{reinterpret_cast<const CanonicalSig*>(sig),
                           CanonicalTypeIndex{kNoSuperType}, kFinal,
                           SharedFlag{false}};
+  WasmSharedAllocationScope shared_allocation;
   base::MutexGuard guard(&mutex_);
   if (V8_UNLIKELY(canonical_supertypes_.size() == kMaxCanonicalTypes)) {
     auto oom_detail = base::FormattedString{}
@@ -403,6 +456,7 @@
   // clear.
   CHECK_EQ(GetWasmEngine()->NativeModuleCount(), 0);
 
+  WasmSharedAllocationScope shared_allocation;
   base::MutexGuard mutex_guard(&mutex_);
   canonical_types_.ClearForTesting();
   canonical_supertypes_.clear();
