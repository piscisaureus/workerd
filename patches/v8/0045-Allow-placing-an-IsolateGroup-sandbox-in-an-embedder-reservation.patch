+#ifdef V8_CAN_ADOPT_ADDRESS_SPACE_RESERVATION
+std::unique_ptr<v8::VirtualAddressSpace> VirtualAddressSpace::AdoptSubspace(
+    Address base, size_t size, PagePermissions max_page_permissions,
+    std::optional<MemoryProtectionKeyId> key) {
+  CHECK_NE(base, kNullAddress);
+  CHECK(IsAligned(base, allocation_granularity()));
+  CHECK(IsAligned(size, allocation_granularity()));
+  // The sandbox and other users never need executable pages, and a
+  // caller-owned mapping was not created with MAP_JIT.
+  CHECK_NE(max_page_permissions, PagePermissions::kReadWriteExecute);
+
+  // On POSIX a reservation is simply a private inaccessible mapping that gets
+  // remapped in place, which is exactly what the caller hands us.
+  AddressSpaceReservation reservation(reinterpret_cast<void*>(base), size);
+  constexpr bool kOwnsReservation = false;
+  return std::unique_ptr<v8::VirtualAddressSpace>(new VirtualAddressSubspace(
+      reservation, this, max_page_permissions, key, kOwnsReservation));
+}
+#endif  // V8_CAN_ADOPT_ADDRESS_SPACE_RESERVATION
+
