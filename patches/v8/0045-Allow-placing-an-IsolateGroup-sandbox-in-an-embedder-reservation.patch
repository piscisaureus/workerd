+#ifdef V8_CAN_ADOPT_ADDRESS_SPACE_RESERVATION
+void Sandbox::InitializeAt(v8::Platform* platform, v8::VirtualAddressSpace* vas,
+                           Address reservation_base, size_t reservation_size) {
+  CHECK(!initialized_);
+  CHECK(vas->CanAllocateSubspaces());
+  CHECK_NE(reservation_base, kNullAddress);
+  CHECK(IsAligned(reservation_base, kSandboxAlignment));
+  CHECK_LT(kSandboxSize, DetermineAddressSpaceLimit());
+
+  // An adopted sandbox always has guard regions, so the reservation must be
+  // large enough to hold them.
+  constexpr bool use_guard_regions = true;
+  constexpr size_t true_reservation_size = kSandboxSize +
+                                           2 * kSandboxGuardRegionSize +
+                                           kAdditionalTrailingGuardRegionSize;
+  CHECK_GE(reservation_size, true_reservation_size);
+
+#if defined(LEAK_SANITIZER)
+  // The platform virtual address space is wrapped for LSan and cannot adopt
+  // reservations.
+  FATAL("Adopting a sandbox reservation is not supported under LSan");
+#else
+  // The platform virtual address space is always the root
+  // base::VirtualAddressSpace (see GetPlatformVirtualAddressSpace()).
+  auto* root_vas = static_cast<base::VirtualAddressSpace*>(vas);
+  address_space_ = root_vas->AdoptSubspace(
+      reservation_base, true_reservation_size, kSandboxMaxPermissions,
+      SandboxMemoryProtectionKey());
+#endif  // defined(LEAK_SANITIZER)
+  CHECK(address_space_);
+
+  InitializeFullyReserved(platform, vas, kSandboxSize, use_guard_regions);
+  RegisterInitializedSandbox();
+
+  DCHECK(initialized_);
+  DCHECK_EQ(reservation_base_, reservation_base);
+  DCHECK_EQ(base_, reservation_base + kSandboxGuardRegionSize);
+}
+#endif  // V8_CAN_ADOPT_ADDRESS_SPACE_RESERVATION
