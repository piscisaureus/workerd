From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bert Belder <bertbelder@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: Run Intl builtins under an embedder shared-allocation scope

The Intl implementation keeps process-wide containers that it fills
lazily from whichever isolate first needs an entry: the available-locale
sets, the calendar, date format and pattern generator caches, the unit
factory and the currency list, all allocated with the process allocator
from inside the builtin that needed them. An embedder that gives each
isolate its own allocation arena, unaddressable from every other
isolate, then finds those entries in the arena of whichever isolate
first used Intl, where the next isolate's Intl call faults on them.

Let such an embedder define a pair of weak hook functions, under which
every Intl builtin and runtime function runs, so that it can switch the
calling thread's allocation onto memory every isolate shares for the
duration. Without the hooks nothing changes.
---
diff --git a/src/builtins/builtins-intl.cc b/src/builtins/builtins-intl.cc
--- a/src/builtins/builtins-intl.cc
+++ b/src/builtins/builtins-intl.cc
@@ -37,11 +37,68 @@
 #include "src/objects/smi.h"
 #include "unicode/brkiter.h"
 
+// Process-wide Intl state and the embedder's allocator. The Intl implementation
+// keeps process-wide containers that it fills lazily from whichever isolate
+// first needs an entry: the available-locale sets, the calendar, date format
+// and pattern generator caches, the unit factory, the currency list. An
+// embedder that gives each isolate its own allocation arena, unaddressable
+// from other isolates, needs those entries placed elsewhere: it defines the
+// two functions below (both or neither), and every Intl builtin and runtime
+// function then runs between an enter and the matching leave, so that all
+// of its allocations go where the embedder puts memory shared by every
+// isolate. The token the enter returns is handed back to the leave.
+#if defined(__GNUC__) || defined(__clang__)
+extern "C" {
+uintptr_t v8_intl_shared_allocation_enter() __attribute__((weak));
+void v8_intl_shared_allocation_leave(uintptr_t token) __attribute__((weak));
+}
+#define V8_HAS_INTL_SHARED_ALLOCATION_HOOKS 1
+#endif
+
 namespace v8 {
 namespace internal {
 
+namespace {
+// Enters the embedder's shared-allocation state for the lifetime of the
+// scope, when the embedder provides it (see the hooks above).
+class IntlSharedAllocationScope final {
+ public:
+  IntlSharedAllocationScope() {
+#ifdef V8_HAS_INTL_SHARED_ALLOCATION_HOOKS
+    if (v8_intl_shared_allocation_enter != nullptr) {
+      token_ = v8_intl_shared_allocation_enter();
+      active_ = true;
+    }
+#endif
+  }
+  ~IntlSharedAllocationScope() {
+#ifdef V8_HAS_INTL_SHARED_ALLOCATION_HOOKS
+    if (active_) v8_intl_shared_allocation_leave(token_);
+#endif
+  }
+  IntlSharedAllocationScope(const IntlSharedAllocationScope&) = delete;
+  IntlSharedAllocationScope& operator=(const IntlSharedAllocationScope&) =
+      delete;
+
+ private:
+  uintptr_t token_ = 0;
+  bool active_ = false;
+};
+}  // namespace
+
+// A builtin whose body runs inside an IntlSharedAllocationScope.
+#define INTL_BUILTIN(name)                                                 \
+  V8_WARN_UNUSED_RESULT static Tagged<Object> Builtin_IntlBody_##name(     \
+      BuiltinArguments args, Isolate* isolate);                            \
+  BUILTIN(name) {                                                          \
+    IntlSharedAllocationScope shared_allocation;                           \
+    return Builtin_IntlBody_##name(args, isolate);                         \
+  }                                                                        \
+  V8_WARN_UNUSED_RESULT static Tagged<Object> Builtin_IntlBody_##name(     \
+      BuiltinArguments args, Isolate* isolate)
+
