diff --git a/src/runtime/runtime-intl.cc b/src/runtime/runtime-intl.cc
--- a/src/runtime/runtime-intl.cc
+++ b/src/runtime/runtime-intl.cc
@@ -19,11 +19,68 @@
 #include "src/objects/js-plural-rules-inl.h"
 #include "src/runtime/runtime-utils.h"
 
+// Process-wide Intl state and the embedder's allocator. The Intl implementation
+// keeps process-wide containers that it fills lazily from whichever isolate
+// first needs an entry: the available-locale sets, the calendar, date format
+// and pattern generator caches, the unit factory, the currency list. An
+// embedder that gives each isolate its own allocation arena, unaddressable
+// from other isolates, needs those entries placed elsewhere: it defines the
+// two functions below (both or neither), and every Intl builtin and runtime
+// function then runs between an enter and the matching leave, so that all
+// of its allocations go where the embedder puts memory shared by every
+// isolate. The token the enter returns is handed back to the leave.
+#if defined(__GNUC__) || defined(__clang__)
+extern "C" {
+uintptr_t v8_intl_shared_allocation_enter() __attribute__((weak));
+void v8_intl_shared_allocation_leave(uintptr_t token) __attribute__((weak));
+}
+#define V8_HAS_INTL_SHARED_ALLOCATION_HOOKS 1
+#endif
+
 namespace v8 {
 namespace internal {
 
+namespace {
+// Enters the embedder's shared-allocation state for the lifetime of the
+// scope, when the embedder provides it (see the hooks above).
+class IntlSharedAllocationScope final {
+ public:
+  IntlSharedAllocationScope() {
+#ifdef V8_HAS_INTL_SHARED_ALLOCATION_HOOKS
+    if (v8_intl_shared_allocation_enter != nullptr) {
+      token_ = v8_intl_shared_allocation_enter();
+      active_ = true;
+    }
+#endif
+  }
+  ~IntlSharedAllocationScope() {
+#ifdef V8_HAS_INTL_SHARED_ALLOCATION_HOOKS
+    if (active_) v8_intl_shared_allocation_leave(token_);
+#endif
+  }
+  IntlSharedAllocationScope(const IntlSharedAllocationScope&) = delete;
+  IntlSharedAllocationScope& operator=(const IntlSharedAllocationScope&) =
+      delete;
+
+ private:
+  uintptr_t token_ = 0;
+  bool active_ = false;
+};
+}  // namespace
+
+// A runtime function whose body runs inside an IntlSharedAllocationScope.
+#define INTL_RUNTIME_FUNCTION(Name)                                        \
+  static Tagged<Object> RuntimeIntlBody_##Name(RuntimeArguments args,      \
+                                               Isolate* isolate);          \
+  RUNTIME_FUNCTION(Name) {                                                 \
+    IntlSharedAllocationScope shared_allocation;                           \
+    return RuntimeIntlBody_##Name(args, isolate);                          \
+  }                                                                        \
+  static Tagged<Object> RuntimeIntlBody_##Name(RuntimeArguments args,      \
+                                               Isolate* isolate)
