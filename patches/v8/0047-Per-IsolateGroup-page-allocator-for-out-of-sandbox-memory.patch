--- a/include/v8-isolate.h
+++ b/include/v8-isolate.h
@@ -269,6 +269,28 @@
      */
     void* sandbox_reservation = nullptr;
     size_t sandbox_reservation_size = 0;
+
+    /**
+     * When set, the memory that the group keeps outside of its sandbox (and
+     * pointer compression cage), i.e. the code range and the trusted range,
+     * is allocated through this page allocator instead of the platform's page
+     * allocator. This lets an embedder that manages the address space itself
+     * decide where a group's out-of-sandbox memory lives.
+     *
+     * The allocator must outlive the group. V8 calls AllocatePages (with a
+     * hint that may be ignored, but the requested alignment must be honored),
+     * FreePages, ReleasePages, SetPermissions, RecommitPages,
+     * DiscardSystemPages, DecommitPages, AllocatePageSize, CommitPageSize and
+     * GetRandomMmapAddr on it; SealPages is used when memory sealing is
+     * enabled.
+     *
+     * Memory that V8 obtains for the group in other ways is not affected: the
+     * sandbox itself, pointer tables backed by the platform's virtual address
+     * space, and ordinary malloc'ed memory. A CppHeap attached to an isolate
+     * of the group has its own page allocator; see
+     * CppHeapCreateParams::page_allocator to place it alongside.
+     */
+    v8::PageAllocator* page_allocator = nullptr;
   };
 
