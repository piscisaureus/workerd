+enum class ArmKind: uint8_t {
+  // Which of an event loop's insert points an arm places an event at; the names match the Event
+  // methods armDepthFirst(), armBreadthFirst(), armLast() and armWhenWouldSleep().
+  DEPTH_FIRST,
+  BREADTH_FIRST,
+  LAST,
+  WHEN_WOULD_SLEEP
+};
+
+struct EventQueueHooks {
+  // Function pointers an embedder installs with setEventQueueHooks() to run every EventLoop's run
+  // queue out of memory the loop's own events can reach. When they are installed the loop delegates
+  // each queue operation to them and never touches its inline queue; when none are installed (the
+  // default) the loop walks and mutates that inline queue itself, so a build that installs nothing
+  // behaves exactly as it would without this. An embedder that runs the loop's work under memory
+  // isolation keeps the queue in memory the work cannot address and lets the work journal its arms
+  // and disarms rather than write that memory directly; the hooks are where that redirection lives.
+  //
+  // arm() enqueues `event` at `kind`'s insert point; disarm() removes it if armed; both run for the
+  // loop whose turn, or whose host-side frame, is arming or disarming. head() returns the first
+  // event in the main queue or null when it holds none. wouldSleepEmpty() is whether the separate
+  // would-sleep queue is empty and firstWouldSleep() is its first event. resetDepthFirst() moves the
+  // depth-first insert point back to the head of the main queue, as turn() does around a fire().
+  // onLoopConstructed()/onLoopDestroyed() let the embedder set up and tear down the loop's relocated
+  // queue; onLoopDestroyed() replaces the inline teardown of the link pool.
+  void (*arm)(EventLoop& loop, Event& event, ArmKind kind);
+  void (*disarm)(EventLoop& loop, Event& event);
+  Event* (*head)(EventLoop& loop);
+  bool (*wouldSleepEmpty)(EventLoop& loop);
+  Event* (*firstWouldSleep)(EventLoop& loop);
+  void (*resetDepthFirst)(EventLoop& loop);
+  void (*onLoopConstructed)(EventLoop& loop);
+  void (*onLoopDestroyed)(EventLoop& loop);
+};
+
+extern const EventQueueHooks* eventQueueHooks;
+// The installed hooks, or null when the loop uses its own inline queue. Read on every queue
+// operation; declared here so EventLoop::head() can test it without a function call.
+
+inline const EventQueueHooks* getEventQueueHooks() { return eventQueueHooks; }
+void setEventQueueHooks(const EventQueueHooks* hooks);
+// Install (or, with null, remove) the queue hooks. Called once, host-side, before any loop runs
+// work the embedder does not trust.
