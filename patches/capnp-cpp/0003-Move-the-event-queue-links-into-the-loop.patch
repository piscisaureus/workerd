 // Global counter used to assign a unique id to each EventLoop.
 }  // namespace
 
+struct EventLoop::LinkChunk {
+  // A chunk of run-queue links, followed in memory by the links themselves.
+  LinkChunk* next;
+  size_t bytes;
+};
+
+namespace {
+
+void* mapLinkChunk(size_t bytes) {
+  // A link chunk comes straight from the OS rather than from the C++ heap because an embedder
+  // that runs the loop's work under memory isolation gives each unit of work a heap of its own,
+  // and a chunk allocated while a unit runs would land in that unit's heap, where no other unit
+  // can address it. A fresh OS mapping belongs to no unit.
+#if _WIN32 || __CYGWIN__
+  void* result = VirtualAlloc(nullptr, bytes, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+  KJ_ASSERT(result != nullptr, "VirtualAlloc(event queue links) failed");
+  return result;
+#else
+#ifndef MAP_ANONYMOUS
+#define MAP_ANONYMOUS MAP_ANON
+#endif
+  void* result = mmap(nullptr, bytes, PROT_READ | PROT_WRITE,
+                      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (result == MAP_FAILED) {
+    KJ_FAIL_SYSCALL("mmap(event queue links)", errno);
+  }
+  return result;
+#endif
+}
+
+void unmapLinkChunk(void* ptr, size_t bytes) {
+#if _WIN32 || __CYGWIN__
+  (void)bytes;
+  VirtualFree(ptr, 0, MEM_RELEASE);
+#else
+  KJ_SYSCALL(munmap(ptr, bytes)) { break; }
+#endif
+}
+
+}  // namespace
+
+size_t EventLoop::linksPerChunk(size_t chunkBytes) {
+  return (chunkBytes - sizeof(LinkChunk)) / sizeof(_::EventLink);
+}
+
+_::EventLink* EventLoop::chunkLinks(LinkChunk* chunk) {
+  return reinterpret_cast<_::EventLink*>(chunk + 1);
+}
+
+_::EventLink* EventLoop::growLinks() {
+  size_t bytes = nextChunkBytes;
+  nextChunkBytes = kj::min(bytes * 2, MAX_LINK_CHUNK_BYTES);
+
+  LinkChunk* chunk = reinterpret_cast<LinkChunk*>(mapLinkChunk(bytes));
+  chunk->next = linkChunks;
+  chunk->bytes = bytes;
+  linkChunks = chunk;
+
+  // Push the new links on the free list back to front, so that the first arm takes the first of
+  // them and a run of arms walks the chunk forwards.
+  _::EventLink* links = chunkLinks(chunk);
+  for (size_t i = linksPerChunk(bytes); i > 0; i--) {
+    _::EventLink& link = links[i - 1];
+    link.event = nullptr;
+    link.loop = this;
+    link.next = freeLinks;
+    freeLinks = &link;
+  }
+  return freeLinks;
+}
+
