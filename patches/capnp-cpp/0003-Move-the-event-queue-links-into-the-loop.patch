+struct EventLink {
+  // An event's place in an event loop's run queue. The queue is a doubly linked list through
+  // these links rather than through the events themselves: an armed event points at the link the
+  // loop gave it, and the link points back at the event. The loop owns the links -- it allocates
+  // them from its own memory and recycles them -- so arming or disarming an event writes the
+  // loop's memory and the event's own `link` field, never another event's.
+  //
+  // That is what an embedder needs when it runs the loop's work under memory isolation, where a
+  // unit of work may address only its own objects. With the links inside the events, unlinking a
+  // queued event writes the link fields of whichever events happen to be queued beside it, which
+  // may belong to another unit and be unaddressable from this one.
+
+  EventLink* next;
+  // The next link in the queue, or null at the end of one.
+
+  EventLink** prev;
+  // Points at the `next` field that points at this link.
+
+  Event* event;
+  // The event whose place this is, or null for one of the loop's own sentinels and for a link on
+  // the loop's free list. A walk of the queue skips a link with no event.
+
+  kj::EventLoop* loop;
+  // The loop that owns the link, which is where a disarm returns it. Null for the sentinels,
+  // which are never returned.
+
+  inline void unlink() {
+    *prev = next;
+    next->prev = prev;
+  }
+
+  inline void insertBefore(EventLink& other) {
+    // Insert this link before `other` in the list.
+    prev = other.prev;
+    *prev = this;
+    next = &other;
+    other.prev = &next;
+  }
+
+  inline void insertAfter(EventLink& other) { insertBefore(*other.next); }
+};
 
